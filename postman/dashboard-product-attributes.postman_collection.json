              "query": [
                { "key": "per_page", "value": "15", "description": "Number of items per page" },
                { "key": "search", "value": "", "description": "Search by product name, attribute name, or attribute value" },
                { "key": "product_id", "value": "", "description": "Filter by product ID" },
                { "key": "attribute_id", "value": "", "description": "Filter by attribute ID" }
              ]
