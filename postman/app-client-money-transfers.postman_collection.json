{
  "info": {
    "name": "App - Client - Money Transfers",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Client money transfer endpoints: create transfer, list, show, cancel."
  },
  "item": [
    {
      "name": "Create Money Transfer",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Accept", "value": "application/json" },
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": {
          "raw": "{{base_url}}/api/client/money-transfers",
          "host": [ "{{base_url}}" ],
          "path": [ "api", "client", "money-transfers" ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"bank_name\": \"My Bank\",\n  \"account_number\": \"1234567890\",\n  \"iban\": \"SA0380000000608010167519\",\n  \"amount\": 100.50\n}"
        }
      }
    },
    {
      "name": "List Money Transfers",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Accept", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": {
          "raw": "{{base_url}}/api/client/money-transfers?status=&per_page=15",
          "host": [ "{{base_url}}" ],
          "path": [ "api", "client", "money-transfers" ],
          "query": [
            { "key": "status", "value": "" },
            { "key": "per_page", "value": "15" }
          ]
        }
      }
    },
    {
      "name": "Show Money Transfer",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Accept", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": {
          "raw": "{{base_url}}/api/client/money-transfers/{{transferId}}",
          "host": [ "{{base_url}}" ],
          "path": [ "api", "client", "money-transfers", "{{transferId}}" ]
        }
      }
    },
    {
      "name": "Cancel Money Transfer",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Accept", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": {
          "raw": "{{base_url}}/api/client/money-transfers/{{transferId}}/cancel",
          "host": [ "{{base_url}}" ],
          "path": [ "api", "client", "money-transfers", "{{transferId}}", "cancel" ]
        }
      }
    }
  ],
  "variable": [
    { "key": "base_url", "value": "http://localhost:8000" },
    { "key": "token", "value": "" },
    { "key": "transferId", "value": "1" }
  ]
}


