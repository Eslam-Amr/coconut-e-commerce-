{
  "info": {
    "_postman_id": "7c2a3dcb-2c9b-4a2b-9c5e-guest-products-collection",
    "name": "App - Guest - Products",
    "description": "Guest-facing product endpoints: list, show, recommendations, trending, featured, related",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Products",
      "item": [
        {
          "name": "List Products",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/app/guest/products?per_page=12&category_id=&brand_id=&search=",
              "host": ["{{base_url}}"],
              "path": ["api", "app", "guest", "products"],
              "query": [
                { "key": "per_page", "value": "12", "description": "Items per page" },
                { "key": "category_id", "value": "", "description": "Filter by category id" },
                { "key": "brand_id", "value": "", "description": "Filter by brand id" },
                { "key": "search", "value": "", "description": "Search by product name or description" }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Show Product",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/app/guest/products/{{product_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "app", "guest", "products", "{{product_id}}"]
            }
          },
          "response": []
        },
        {
          "name": "Related Products",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/app/guest/products/{{product_id}}/related?limit=6",
              "host": ["{{base_url}}"],
              "path": ["api", "app", "guest", "products", "{{product_id}}", "related"],
              "query": [
                { "key": "limit", "value": "6", "description": "Number of related products" }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Recommendations",
          "request": {
            "method": "GET",
