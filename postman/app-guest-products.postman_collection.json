              ]
            }
          },
          "response": []
        },
        {
          "name": "Featured Products",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/app/guest/products/featured?limit=8",
              "host": ["{{base_url}}"],
              "path": ["api", "app", "guest", "products", "featured"],
              "query": [
                { "key": "limit", "value": "8", "description": "Number of featured products" }
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Product Examples",
      "item": [
        {
          "name": "Search Products",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/app/guest/products?search=iPhone&per_page=10",
