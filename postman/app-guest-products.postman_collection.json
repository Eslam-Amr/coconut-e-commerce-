              "query": [
                { "key": "limit", "value": "12", "description": "Number of recommendations" }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Trending Products",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/app/guest/products/trending?limit=8",
