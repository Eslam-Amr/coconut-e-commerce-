              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cart_item_id\": {{cart_item_id}},\n  \"by\": 1\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/app/client/cart/decrement",
              "host": ["{{base_url}}"],
              "path": ["api", "app", "client", "cart", "decrement"]
            }
          },
          "response": []
        },
        {
          "name": "Update Cart Item Quantity",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}",
