              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cart_item_id\": {{cart_item_id}},\n  \"quantity\": 3\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/app/client/cart/update-quantity",
              "host": ["{{base_url}}"],
              "path": ["api", "app", "client", "cart", "update-quantity"]
            }
          },
          "response": []
        },
        {
          "name": "Remove Cart Item",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}",
                "description": "JWT token for authenticated user"
              },
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cart_item_id\": {{cart_item_id}}\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/app/client/cart/remove",
              "host": ["{{base_url}}"],
              "path": ["api", "app", "client", "cart", "remove"]
            }
          },
          "response": []
        }
      ]
    },
