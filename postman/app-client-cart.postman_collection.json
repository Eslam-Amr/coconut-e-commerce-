{
  "info": {
    "_postman_id": "8d3e4f5a-1b2c-3d4e-5f6g-client-cart-collection",
    "name": "App - Client - Cart",
    "description": "Client cart endpoints: view cart, add items, increment/decrement quantities, update quantity, remove items",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Cart Operations",
      "item": [
        {
          "name": "Get Cart",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}",
                "description": "JWT token for authenticated user"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/app/client/cart",
              "host": ["{{base_url}}"],
              "path": ["api", "app", "client", "cart"]
            }
          },
          "response": []
        },
        {
          "name": "Add to Cart",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}",
                "description": "JWT token for authenticated user"
              },
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"product_id\": {{product_id}},\n  \"product_variant_id\": {{product_variant_id}},\n  \"quantity\": 1\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/app/client/cart/add",
              "host": ["{{base_url}}"],
              "path": ["api", "app", "client", "cart", "add"]
            }
          },
          "response": []
        },
        {
          "name": "Increment Cart Item",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}",
                "description": "JWT token for authenticated user"
              },
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cart_item_id\": {{cart_item_id}},\n  \"by\": 1\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/app/client/cart/increment",
              "host": ["{{base_url}}"],
              "path": ["api", "app", "client", "cart", "increment"]
            }
          },
          "response": []
        },
        {
          "name": "Decrement Cart Item",
