            "body": {
              "mode": "raw",
              "raw": "{\n  \"product_id\": 1,\n  \"sku\": \"SHIRT-RED-SMALL-001\",\n  \"price\": 29.99,\n  \"minimum_stock\": 10,\n  \"stock\": 100,\n  \"active\": true,\n  \"attribute_value_ids\": [1, 5, 8]\n}"
