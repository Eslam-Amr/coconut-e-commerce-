      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
             "url": {
               "raw": "{{base_url}}/api/admin/login",
               "host": ["{{base_url}}"],
               "path": ["api", "admin", "login"]
             },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@example.com\",\n  \"password\": \"password\"\n}"
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Product Variants",
      "item": [
        {
          "name": "List Product Variants",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
             "url": {
               "raw": "{{base_url}}/api/admin/product-variants?per_page=15&search=&product_id=&active=&stock_filter=",
               "host": ["{{base_url}}"],
               "path": ["api", "admin", "product-variants"],
              "query": [
                { "key": "per_page", "value": "15", "description": "Number of items per page" },
                { "key": "search", "value": "", "description": "Search by SKU or product name" },
                { "key": "product_id", "value": "", "description": "Filter by product ID" },
                { "key": "active", "value": "", "description": "Filter by active status (true/false)" },
                { "key": "stock_filter", "value": "", "description": "Filter by stock level (in_stock/out_of_stock/low_stock)" }
              ]
            }
          },
          "response": []
        },
