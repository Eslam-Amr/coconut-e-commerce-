{
	"info": {
		"_postman_id": "guest-sliders-collection",
		"name": "Guest Sliders",
		"description": "API endpoints for guest slider operations",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Get All Sliders",
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "Accept",
						"value": "application/json"
					}
				],
				"url": {
					"raw": "{{guest_base_url}}/sliders?limit=10",
					"host": [
						"{{guest_base_url}}"
					],
					"path": [
						"sliders"
					],
					"query": [
						{
							"key": "limit",
							"value": "10",
							"description": "Number of sliders to return (default: 15)"
						}
					]
				}
			},
			"response": []
		},
		{
			"name": "Get Slider by ID",
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "Accept",
						"value": "application/json"
					}
				],
				"url": {
					"raw": "{{guest_base_url}}/sliders/1",
					"host": [
						"{{guest_base_url}}"
					],
					"path": [
						"sliders",
						"1"
					]
				}
			},
			"response": []
		}
	],
	"variable": [
		{
			"key": "guest_base_url",
			"value": "127.0.0.1:8000/guest",
			"type": "string"
		}
	]
}
