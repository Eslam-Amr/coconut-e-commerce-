              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
               "raw": "{{base_url}}/api/admin/products/{{product_id}}?_method=PUT",
               "host": ["{{base_url}}"],
               "path": ["api", "admin", "products", "{{product_id}}"],
              "query": [{ "key": "_method", "value": "PUT" }]
            },
            "body": {
              "mode": "formdata",
              "formdata": [
