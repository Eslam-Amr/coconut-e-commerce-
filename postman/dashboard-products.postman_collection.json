{
  "info": {
    "_postman_id": "a1b2c3d4-5e6f-7g8h-9i0j-k1l2m3n4o5p6",
    "name": "Dashboard - Products",
    "description": "API collection for Product management endpoints",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
             "url": {
               "raw": "{{base_url}}/api/admin/login",
               "host": ["{{base_url}}"],
               "path": ["api", "admin", "login"]
             },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@example.com\",\n  \"password\": \"password\"\n}"
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Products",
      "item": [
        {
          "name": "List Products",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
             "url": {
               "raw": "{{base_url}}/api/admin/products?per_page=15&search=&category_id=&brand_id=&active=",
               "host": ["{{base_url}}"],
               "path": ["api", "admin", "products"],
              "query": [
                { "key": "per_page", "value": "15", "description": "Number of items per page" },
                { "key": "search", "value": "", "description": "Search by product name" },
                { "key": "category_id", "value": "", "description": "Filter by category ID" },
                { "key": "brand_id", "value": "", "description": "Filter by brand ID" },
                { "key": "active", "value": "", "description": "Filter by active status (true/false)" }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Create Product",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
               "raw": "{{base_url}}/api/admin/products",
               "host": ["{{base_url}}"],
               "path": ["api", "admin", "products"]
            },
            "body": {
              "mode": "formdata",
              "formdata": [
                { 
                  "key": "name", 
                  "value": "Sample Product", 
                  "type": "text",
                  "description": "Product name (required)"
                },
                { 
                  "key": "description", 
                  "value": "{\"en\": \"Product description in English\", \"ar\": \"وصف المنتج بالعربية\"}", 
                  "type": "text",
                  "description": "Product description as JSON object"
                },
                { 
                  "key": "category_id", 
                  "value": "1", 
                  "type": "text",
                  "description": "Category ID (required)"
                },
                { 
                  "key": "brand_id", 
                  "value": "1", 
                  "type": "text",
                  "description": "Brand ID (optional)"
                },
                { 
                  "key": "total_quantity", 
                  "value": "100", 
                  "type": "text",
                  "description": "Total quantity available"
                },
                { 
                  "key": "base_price", 
                  "value": "99.99", 
                  "type": "text",
                  "description": "Base price (required)"
                },
                { 
                  "key": "active", 
                  "value": "true", 
                  "type": "text",
                  "description": "Product active status"
                },
                { 
                  "key": "image", 
                  "type": "file", 
                  "src": "",
                  "description": "Product image (jpeg, png, jpg, gif, webp, max 5MB)"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Show Product",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
               "raw": "{{base_url}}/api/admin/products/{{product_id}}",
               "host": ["{{base_url}}"],
               "path": ["api", "admin", "products", "{{product_id}}"]
            }
          },
          "response": []
        },
