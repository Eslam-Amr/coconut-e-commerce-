			"request": {
				"method": "GET",
				"header": [
					{
						"key": "Accept",
						"value": "application/json"
					},
					{
						"key": "Authorization",
						"value": "Bearer {{admin_token}}",
						"type": "text"
					}
				],
				"url": {
					"raw": "{{admin_base_url}}/static-pages?search=about&per_page=10&sort_by=created_at&sort_order=desc",
					"host": [
						"{{admin_base_url}}"
					],
					"path": [
						"static-pages"
					],
					"query": [
						{
							"key": "search",
							"value": "about",
							"description": "Search in title and content"
						},
						{
							"key": "slug",
							"value": "",
							"description": "Filter by slug",
							"disabled": true
						},
						{
							"key": "per_page",
							"value": "10",
							"description": "Number of pages per page"
						},
						{
							"key": "sort_by",
							"value": "created_at",
							"description": "Sort by field"
						},
						{
							"key": "sort_order",
							"value": "desc",
							"description": "Sort order (asc/desc)"
						}
					]
				}
			},
			"response": []
